{
	admin off
	auto_https off
	persist_config off
}

:{$PORT} {
	# Health and version answer without a token (Railway's health check uses /api/v2/heartbeat).
	@public path /api/v2/heartbeat /api/v2/version /api/v1/heartbeat /api/v1/version
	# CORS preflight requests never carry credentials.
	@preflight method OPTIONS
	# Chroma clients send the token either way.
	@token header X-Chroma-Token {$CHROMA_AUTH_TOKEN}
	@bearer header Authorization "Bearer {$CHROMA_AUTH_TOKEN}"

	handle @public {
		reverse_proxy 127.0.0.1:{$CHROMA_INTERNAL_PORT}
	}
	handle @preflight {
		reverse_proxy 127.0.0.1:{$CHROMA_INTERNAL_PORT}
	}
	handle @token {
		reverse_proxy 127.0.0.1:{$CHROMA_INTERNAL_PORT}
	}
	handle @bearer {
		reverse_proxy 127.0.0.1:{$CHROMA_INTERNAL_PORT}
	}
	handle {
		header Content-Type application/json
		respond `{"error":"Unauthorized","message":"Send CHROMA_AUTH_TOKEN in the X-Chroma-Token header or as Authorization: Bearer <token>"}` 401
	}
}
